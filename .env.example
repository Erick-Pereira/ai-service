# Copie para .env ao correr Simcag.AIService.Api (DotNetEnv carrega da pasta de trabalho).
# Valores alinhados a Simcag.AIService.Api/Program.cs e Application/Configuration/AiServiceEnvironment.cs.

# ——— Ollama (obrigatório em produção: host acessível; modelo resolvido por MODEL_NAME) ——
OLLAMA__HOST=http://localhost:11434
# Alternativa legada: OLLAMA_BASE_URL
# Tag exata listada em GET /api/tags (ex.: llama3.1:8b). Se MODEL_NAME não existir no host, o cliente tenta fallback (ex.: llama3.1:*).
# Evite valores como mistral:latest se esse modelo não estiver instalado no Ollama.
MODEL_NAME=llama3.1:8b
# Mínimo 30. Default no código: 180.
OLLAMA__TIMEOUT_SECONDS=180

# ——— Redis (opcional; sem REDIS_CONNECTION usa cache em memória) ——
# REDIS__CONNECTION=localhost:6379

# ——— RabbitMQ ——
RABBITMQ__HOST=localhost
RABBITMQ__PORT=5672
RABBITMQ__USERNAME=guest
RABBITMQ__PASSWORD=guest
RABBITMQ__VIRTUALHOST=/
# Exchange de eventos de domínio (default no código: events)
# RABBITMQ__EVENTS_EXCHANGE=events
# Consumidores: raw-financial-data-events (legado) + ai-data-ingested-events (canónico DataIngestedEvent)

# ——— TTLs e limiares (opcionais; têm default no código) ——
# AI_INFERENCE_CACHE_TTL_HOURS=72
# SUPPLIER_NORMALIZATION_TTL_HOURS=168
# IDEMPOTENCY_TTL_HOURS=24
# Confiança global 0–1 (default 0.55)
# AI_LOW_CONFIDENCE_THRESHOLD=0.55
# Tamanho máximo do texto bruto enviado ao prompt de extração de linhas (default 14000)
# AI_LINE_ITEMS_MAX_CHARS=14000
